# =============================================================================
# Ajo Mercy — environment
# Copy to .env.local and fill in. Never commit .env.local.
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Project Settings → API. The anon key is safe in the browser; RLS constrains it.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Bypasses RLS entirely. Server-side only — never prefix this with NEXT_PUBLIC_,
# never reference it from a client component.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Direct Postgres connection, used only by `npm run db:push` to apply migrations.
# Project Settings → Database → Connection string (URI).
SUPABASE_DB_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# --- Site ---------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for email links, OG tags and sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Email (Resend) -----------------------------------------------------------
# Leave RESEND_API_KEY empty in development: emails are logged to the console and
# recorded in email_events as failed, rather than silently pretending to send.
RESEND_API_KEY=""
EMAIL_FROM="Ajo Mercy <hello@ajomercy.com>"
EMAIL_REPLY_TO="support@ajomercy.com"
# Where "something needs review" alerts go if no admin account exists yet.
ADMIN_ALERT_EMAIL="admin@ajomercy.com"
# Optional: verifies Resend delivery webhooks at /api/webhooks/resend.
RESEND_WEBHOOK_SECRET=""

# --- Scheduled notices --------------------------------------------------------
# Shared secret for /api/cron/notices, which sends the applicant reminders and
# the staff alerts once a day. Vercel Cron presents it as an Authorization
# header of the form "Bearer <secret>". At least 16 characters.
#
# If unset the endpoint returns 503 and sends nothing, so a deployment without
# it is quiet rather than open to anyone who finds the URL. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# --- Cloudflare Turnstile -----------------------------------------------------
# Both must be set for bot protection to run. If unset, verification is skipped
# and a warning is logged in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Security -----------------------------------------------------------------
# Salt for hashing IPs and device signals before storage. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this invalidates existing abuse-detection history.
HASH_SALT="change-me-to-a-32-byte-random-hex-string"

# --- Bootstrap ----------------------------------------------------------------
# Used once by `node scripts/bootstrap-admin.mjs` to create the super admin.
SUPER_ADMIN_EMAIL="woli@ajomercy.com"
SUPER_ADMIN_NAME="Woli Arole"
SUPER_ADMIN_PASSWORD=""

# --- Development only ---------------------------------------------------------
# Set to "true" to expose /designs/* and /admin/designs/* in a production build.
# Leave unset so the design explorations stay out of the live site.
ENABLE_DESIGN_ROUTES=""
